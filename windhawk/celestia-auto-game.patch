 std::atomic<bool> g_gameOverlayPinned{false};
+
+// ── Celestia patch: auto game mode ──────────────────────────────────────────
+// While a known game window is in the foreground the island switches to the
+// game overlay by itself, stays visible in full screen (borderless) and is not
+// taken over by media or popups. Leaving the game restores normal behaviour.
+std::atomic<bool> g_gameAutoActive{false};
+
+inline bool GameOverlayOn(const Settings& s) {
+    return s.gameOverlay || g_gameOverlayPinned.load() || g_gameAutoActive.load();
+}
+
+inline bool IsGameForeground() {
+    static const wchar_t* const kGameExes[] = {
+        L"FortniteClient-Win64-Shipping.exe",
+    };
+    HWND fg = GetForegroundWindow();
+    if (!fg) return false;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(fg, &pid);
+    if (pid) {
+        if (HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid)) {
+            wchar_t path[MAX_PATH] = {};
+            DWORD n = MAX_PATH;
+            const bool ok = QueryFullProcessImageNameW(h, 0, path, &n) != FALSE;
+            CloseHandle(h);
+            if (ok) {
+                const wchar_t* name = wcsrchr(path, L'\\');
+                name = name ? name + 1 : path;
+                for (const wchar_t* exe : kGameExes) {
+                    if (_wcsicmp(name, exe) == 0) return true;
+                }
+                return false;
+            }
+        }
+    }
+    // Fallback when the process cannot be opened (anti-cheat): Unreal window titled Fortnite.
+    wchar_t cls[64] = {}, title[64] = {};
+    GetClassNameW(fg, cls, 64);
+    GetWindowTextW(fg, title, 64);
+    return wcscmp(cls, L"UnrealWindow") == 0 && wcsncmp(title, L"Fortnite", 8) == 0;
+}
